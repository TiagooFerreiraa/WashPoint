<!DOCTYPE html>
<html lang="pt">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WashPoint</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4">
      <a class="navbar-brand fw-bold" href="/">🚗 WashPoint</a>

      <div class="ms-auto d-flex gap-3 align-items-center">
        <span class="text-white small">
          Bem-vindo, <%= utilizador.nome %>
        </span>

        <a href="/logout" class="btn btn-outline-light btn-sm">
          Logout
        </a>
      </div>
    </nav>
    <div class="container py-5">
      <h2 class="mb-4 fw-bold">Serviços disponíveis</h2>
      <div class="row g-4">
        <% servicos.forEach(servico => { %>
          <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title fw-bold">
                  <%= servico.nome %>
                </h5>
                <p class="text-muted mb-2">
                  <%= servico.descricao || "Serviço profissional de lavagem" %>
                </p>
                <h6 class="mb-3 text-primary fw-bold">
                  €<%= servico.preco %>
                </h6>
                <p class="small text-secondary">
                  ⏱ <%= servico.duracao %> minutos
                </p>
                <a href="/booking?servico=<%= servico.id %>" 
                  class="btn btn-primary mt-auto">
                  Agendar
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>